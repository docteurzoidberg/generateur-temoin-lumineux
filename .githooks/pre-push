#!/bin/sh
# Before every push: typecheck and all the tests, the page tests in headless Chromium
# included (the GitHub action only typechecks, builds and publishes). Refused on
# uncommitted changes, so that what is tested is what is pushed. Enabled by npm install
# (core.hooksPath); bypass: git push --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push : modifications non commitées ; commiter ou mettre de côté avant de pousser." >&2
  exit 1
fi
echo "pre-push : typecheck et tests…"
npm run typecheck --silent && npm test --silent || {
  echo "pre-push : échec, rien n'est poussé." >&2
  exit 1
}
